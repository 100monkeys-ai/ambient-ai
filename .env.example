# Copy to .env at the repository root. Never commit .env.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
APP_SECRET=
PORTAL_BASE_URL=
DB_PATH=
ANTHROPIC_API_KEY=
CORTEX_MCP_URL=
CORTEX_MCP_TOKEN=
CORTEX_WORKSPACE=
# Telemetry line stream to stdout; on by default, set to 0 to silence it.
TELEMETRY_STREAM=
# Also append each redacted event line to this file; python -m ambient_ai.telemetry.tail follows it.
TELEMETRY_LOG_FILE=
# Record outbound SMS to this file instead of calling Twilio (local runs only).
FAKE_SMS_OUTBOX=
# Telegram: the bot token from BotFather; the webhook is set at startup only when this is present.
TELEGRAM_BOT_TOKEN=
# Value Telegram echoes in X-Telegram-Bot-Api-Secret-Token; generated per process when unset.
TELEGRAM_WEBHOOK_SECRET=
# Record outbound Telegram sends to this file instead of calling the Bot API (local runs only).
FAKE_TELEGRAM_OUTBOX=
# Set to 1 to keep the pydantic-ai banner out of the projector view.
PYDANTIC_AI_NO_BANNER=
